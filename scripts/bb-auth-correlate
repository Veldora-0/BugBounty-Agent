#!/usr/bin/env python3
"""
bb-auth-correlate — BugBounty-Agent Authentication & Authorization Correlation Engine.

Correlates authentication state transitions, session lifecycles, and authorization
boundaries across multi-session and multi-tenant targets without modifying existing engines.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import time

# Ensure repository root is on sys.path
SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
REPO_ROOT = os.path.abspath(os.path.join(SCRIPT_DIR, ".."))
if REPO_ROOT not in sys.path:
    sys.path.insert(0, REPO_ROOT)

from framework.auth_correlation.engine import AuthCorrelationEngine
from framework.auth_correlation.state import AuthCorrelationStateManager
from framework.auth_correlation.lab import LocalAuthCorrelationLab, SecurityBoundaryViolationError
from framework.auth_correlation.model import CorrelatedPrincipalContext, CorrelatedSessionContext, CorrelationLifecycle
from framework.auth_correlation.revocation import ApprovalSecurityError, sign_action_approval
from framework.validation.request import ControlledRequest, ControlledResponse


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="bb-auth-correlate",
        description="Phase 21: Authentication & Authorization Correlation Engine.",
    )
    parser.add_argument("--program", default="default-program", help="Target bug bounty program identifier")
    parser.add_argument("--workspace", help="Target workspace root containing state, scope, and evidence")
    parser.add_argument("--target", help="Target endpoint or asset URL")
    parser.add_argument("--tree", action="store_true", help="Render visual ASCII correlation tree")
    parser.add_argument("--passive-only", action="store_true", help="Model correlation contexts without sending network traffic")
    parser.add_argument("--dry-run", action="store_true", help="Plan correlation tests without sending network probes")
    parser.add_argument("--preflight", "--preflight-only", dest="preflight", action="store_true", help="Execute dual-control preflight session health verification only")
    parser.add_argument("--revocation", action="store_true", help="Execute post-revocation resource verification (Mode A)")
    parser.add_argument("--approve-action", dest="approve_action", help="Grant single-use approval for controlled mutation in Mode B (ACT-<SHA256>)")
    parser.add_argument("--sign-dossier", dest="sign_dossier", help="Sign an action dossier JSON file using operator approval key")
    parser.add_argument("--pre-mfa", dest="pre_mfa", action="store_true", help="Execute pre-MFA privilege boundary analysis")
    parser.add_argument("--tenant", action="store_true", help="Execute multi-tenant dual-token desynchronization")
    parser.add_argument("--dossier", help="Path to action dossier JSON file for Mode B approved mutation")
    parser.add_argument("--lab", action="store_true", help="Execute against the local deterministic simulation lab")
    parser.add_argument("--validate", action="store_true", help="Execute full active correlation validation")
    parser.add_argument("--json", action="store_true", help="Output machine-readable JSON")
    parser.add_argument("--output", help="Write summary results to file path")

    args = parser.parse_args()

    # Operator Action Dossier Signing Helper
    if args.sign_dossier:
        if not os.path.exists(args.sign_dossier):
            print(f"[!] Error: Dossier file '{args.sign_dossier}' not found.", file=sys.stderr)
            return 1
        with open(args.sign_dossier, "r", encoding="utf-8") as f:
            raw_dossier = json.load(f)
        signed = sign_action_approval(raw_dossier)
        out_str = json.dumps(signed, indent=2)
        if args.output:
            with open(args.output, "w", encoding="utf-8") as f:
                f.write(out_str)
            print(f"[+] Signed dossier written to '{args.output}'")
        else:
            print(out_str)
        return 0

    # Determine workflow selection filter
    workflow_filter = None
    if args.revocation or args.pre_mfa or args.tenant:
        workflow_filter = set()
        if args.revocation:
            workflow_filter.add("revocation")
        if args.pre_mfa:
            workflow_filter.add("pre_mfa")
        if args.tenant:
            workflow_filter.add("tenant")
    elif args.validate:
        workflow_filter = {"revocation", "pre_mfa", "tenant"}

    # Resolve action dossier if Mode B approval passed
    action_dossier = None
    if args.approve_action:
        if args.dossier and os.path.exists(args.dossier):
            with open(args.dossier, "r", encoding="utf-8") as f:
                action_dossier = json.load(f)
        else:
            cand_path = os.path.join(REPO_ROOT, "state", "pending_actions", f"{args.approve_action}.json")
            if os.path.exists(cand_path):
                with open(cand_path, "r", encoding="utf-8") as f:
                    action_dossier = json.load(f)

    # Simulation lab execution
    if args.lab:
        import shutil
        import tempfile
        lab = LocalAuthCorrelationLab()
        port = lab.start()
        lab_state_dir = tempfile.mkdtemp(prefix="bb_lab_state_")
        try:
            transport = lab.get_transport()
            engine = AuthCorrelationEngine(
                program_id=args.program,
                workspace_root=tempfile.gettempdir(),
                validation_engine=transport,
                state_manager=AuthCorrelationStateManager(
                    program_id=args.program,
                    workspace_root=tempfile.gettempdir(),
                    state_dir=lab_state_dir,
                ),
                target_asset=f"http://127.0.0.1:{port}",
            )
            # Register lab scenario principals and explicit lab resource targets
            p_a = CorrelatedPrincipalContext(principal_id="lab_usr_a", tenant_id="tenant_a", role="USER")
            p_b = CorrelatedPrincipalContext(principal_id="lab_usr_b", tenant_id="tenant_b", role="USER")
            engine.register_principal(p_a)
            engine.register_principal(p_b)

            from framework.authz.model import ResourceAccessTarget
            engine.register_resource_target(ResourceAccessTarget(
                resource_id="lab_invoices",
                resource_type="INVOICE",
                endpoint=f"http://127.0.0.1:{port}/api/v1/tenant/invoices",
            ))
            engine.register_resource_target(ResourceAccessTarget(
                resource_id="lab_profile",
                resource_type="PROFILE",
                endpoint=f"http://127.0.0.1:{port}/api/v1/profile",
            ))

            s_a_meta = {"mfa_level": "PRE_MFA"} if args.pre_mfa else {}
            s_a = CorrelatedSessionContext(
                session_ref="sess_00000000000000000000000000000001",
                principal_id="lab_usr_a",
                volatile_headers={"Authorization": "Bearer valid_token_a"},
                metadata=s_a_meta,
            )
            if args.revocation:
                engine.register_resource_target(ResourceAccessTarget(
                    resource_id="lab_revoked_inv",
                    resource_type="INVOICE",
                    endpoint=f"http://127.0.0.1:{port}/scen02/invoices/101",
                ))
                # Execute genuine Mode B invalidation workflow into lab evidence store to establish verified provenance
                from framework.common.evidence import EvidenceStore
                lab_ev_store = EvidenceStore(os.path.join(lab_state_dir, "evidence"))
                engine.evidence_store = lab_ev_store
                engine.revocation_validator._evidence_store = lab_ev_store
                appr_key = b"\x01" * 32
                att_key = b"\x02" * 32
                engine.revocation_validator._approval_key = appr_key
                engine.revocation_validator._attestation_key = att_key
                dossier = sign_action_approval(
                    {
                        "action_type": "LOGOUT",
                        "created_at": time.time(),
                        "method": "POST",
                        "program_id": args.program,
                        "target_endpoint": f"http://127.0.0.1:{port}/auth/logout",
                        "test_account": "lab_usr_a",
                        "ttl": 300,
                        "unique_approval_id": f"appr_lab_{int(time.time() * 1000)}",
                    },
                    approval_key=appr_key,
                )
                success = engine.revocation_validator.execute_controlled_invalidation(
                    session_ctx=s_a,
                    action_id=dossier["action_id"],
                    action_dossier=dossier,
                )
                if not success or not s_a.invalidation_evidence_ref:
                    raise RuntimeError("Simulation lab controlled invalidation execution failed")
                s_a.pre_revocation_baseline = transport.send_request(ControlledRequest(
                    url=f"http://127.0.0.1:{port}/api/v1/profile",
                    method="GET",
                    headers={"Authorization": "Bearer valid_token_a"},
                ))
            s_b_meta = {"mfa_level": "FULL_MFA"} if args.pre_mfa else {}
            s_b = CorrelatedSessionContext(
                session_ref="sess_00000000000000000000000000000002",
                principal_id="lab_usr_b",
                volatile_headers={"Authorization": "Bearer valid_token_b"},
                metadata=s_b_meta,
            )
            engine.register_session(s_a)
            engine.register_session(s_b)

            if args.tree:
                print(engine.render_tree())
                return 0

            results = engine.run_correlation(
                target_asset=f"http://127.0.0.1:{port}",
                preflight_only=args.preflight,
                dry_run=args.dry_run or args.passive_only,
                workflow_filter=workflow_filter,
                approved_action_id=args.approve_action,
                action_dossier=action_dossier,
            )
        finally:
            lab.stop()
            shutil.rmtree(lab_state_dir, ignore_errors=True)

        if args.json:
            print(json.dumps(results, indent=2))
        else:
            print(f"[+] Simulation Lab Executed on 127.0.0.1:{port}")
            print(f"    Findings Discovered: {results.get('findings_count', 0)}")
            print(f"    Status: {results.get('status')}")
        return 0

    workspace_root = os.path.abspath(args.workspace) if args.workspace else REPO_ROOT

    # Production/Standard Engine Execution
    engine = AuthCorrelationEngine(
        program_id=args.program,
        workspace_root=workspace_root,
        target_asset=args.target,
    )

    # Attempt to load persistent state if available
    state_file = os.path.join(workspace_root, "state", "auth_correlation.json")
    if os.path.exists(state_file):
        try:
            loaded_state = engine.state_manager.load_state()
            for p_id, p_dict in loaded_state.get("principals", {}).items():
                engine.register_principal(CorrelatedPrincipalContext(**p_dict))
            for s_ref, s_dict in loaded_state.get("sessions", {}).items():
                engine.register_session(CorrelatedSessionContext(
                    session_ref=s_dict["session_ref"],
                    principal_id=s_dict["principal_id"],
                    lifecycle=CorrelationLifecycle(s_dict["lifecycle"]),
                    expires_at=s_dict.get("expires_at"),
                    verified_at=s_dict.get("verified_at"),
                    metadata=s_dict.get("metadata", {}),
                ))
        except Exception as e:
            print(f"[!] Error: Corrupted or invalid correlation state file '{state_file}': {e}", file=sys.stderr)
            return 1

    if args.tree:
        print(engine.render_tree())
        return 0

    is_passive = args.dry_run or args.passive_only
    if args.approve_action and not action_dossier and not is_passive:
        raise ApprovalSecurityError(f"Action dossier for approved action '{args.approve_action}' was not found.")

    if not is_passive:
        if not args.target:
            print("[!] Production correlation requires an active target (--target).", file=sys.stderr)
            return 1
        if len(engine.principals) < 2 or len(engine.sessions) < 2:
            print("[!] Production correlation requires at least two registered principals and sessions.", file=sys.stderr)
            return 1
        if engine.scope_engine:
            if not engine.scope_engine.is_in_scope(args.target):
                print(f"[!] Target '{args.target}' is outside configured program scope.", file=sys.stderr)
                return 1
        else:
            print("[!] No scope engine configured. Active production correlation requires authorized scope.", file=sys.stderr)
            return 1

    results = engine.run_correlation(
        target_asset=args.target,
        preflight_only=args.preflight,
        dry_run=is_passive,
        workflow_filter=workflow_filter,
        approved_action_id=args.approve_action,
        action_dossier=action_dossier,
    )

    if args.json:
        out_str = json.dumps(results, indent=2)
        print(out_str)
        if args.output:
            with open(args.output, "w", encoding="utf-8") as f:
                f.write(out_str)
    else:
        print(f"[*] Correlation run completed for program '{args.program}'")
        print(f"    Status: {results.get('status')}")
        print(f"    Findings: {results.get('findings_count', 0)}")
        if args.output:
            with open(args.output, "w", encoding="utf-8") as f:
                json.dump(results, f, indent=2)

    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except ApprovalSecurityError as e:
        print(f"[!] Action Approval Security Error: {e}", file=sys.stderr)
        sys.exit(2)
    except SecurityBoundaryViolationError as e:
        print(f"[!] Security Boundary Violation: {e}", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"[!] Correlation Engine Error: {e}", file=sys.stderr)
        sys.exit(1)
