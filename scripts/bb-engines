#!/usr/bin/env python3
"""
bb-engines — External Pentesting Engine Management and Detection Utility (Phase 12 / 12.1 Hardening).

Detects, health-checks, dry-runs, executes (with human approval gate), and correlates
external pentesting engines such as Xalgorix and Strix.

Security & Architecture Guarantees:
1. Purely single-agent: external tools are invoked as subprocesses, never as OpenCode agents.
2. Every target URL must pass ScopeEngine before any external engine execution.
3. Execution strictly requires explicit --approve flag; unauthorized runs are blocked.
4. Dry-run details exact command plan without executing.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from typing import Any, Dict, List, Optional

REPO_ROOT = os.environ.get("BUGBOUNTY_AGENT_DIR", os.path.abspath(os.path.join(os.path.dirname(os.path.realpath(__file__)), "..")))
if REPO_ROOT not in sys.path:
    sys.path.insert(0, REPO_ROOT)

from framework.business_logic.state import WorkflowStateManager
from framework.external_engines.base import (
    ExternalEngineStatus,
    ExternalFinding,
    ExternalJob,
)
from framework.external_engines.correlator import (
    ExternalEngineSelector,
    ExternalFindingCorrelator,
)
from framework.external_engines.strix import StrixAdapter
from framework.external_engines.xalgorix import XalgorixAdapter
from framework.scope.engine import ScopeEngine


def get_workspace_dir() -> str:
    return os.path.expanduser(os.environ.get("BUGBOUNTY_WORKSPACE", "~/BugBounty-Workspace"))


def load_scope_engine(program_dir: str, explicit_scope_file: Optional[str] = None) -> ScopeEngine:
    scope_path = explicit_scope_file
    if not scope_path:
        cand = os.path.join(program_dir, "scope", "scope.yaml")
        if os.path.isfile(cand):
            scope_path = cand
    if scope_path and os.path.isfile(scope_path):
        return ScopeEngine.from_file(scope_path)
    # Default permissive local scope for labs
    return ScopeEngine({"targets": {"domains": ["*"]}})


def main():
    parser = argparse.ArgumentParser(
        prog="bb-engines",
        description="External Pentesting Engine Management and Detection Utility",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  bb-engines --list
  bb-engines --detect
  bb-engines --doctor
  bb-engines --program my-program --engine xalgorix --targets "https://target.com" --dry-run
  bb-engines --program my-program --engine xalgorix --targets "https://target.com" --run --approve
  bb-engines --program my-program --correlate
        """,
    )

    parser.add_argument("--list", action="store_true", help="List all registered external engines")
    parser.add_argument("--detect", action="store_true", help="Run capability and CLI presence detection across external engines")
    parser.add_argument("--doctor", action="store_true", help="Run deep diagnostic health check on external pentest engines")
    parser.add_argument("--engine", choices=["xalgorix", "strix"], help="Filter by specific engine name")
    parser.add_argument("-p", "--program", default="default", help="Target program name in BugBounty workspace")
    parser.add_argument("-s", "--scope", help="Path to scope.yaml definition")
    parser.add_argument("-t", "--targets", help="Comma-separated target URLs to test")
    parser.add_argument("--dry-run", action="store_true", help="Display execution plan, scope result, command, and budget without running")
    parser.add_argument("--run", action="store_true", help="Launch external engine (requires --approve)")
    parser.add_argument("--approve", action="store_true", help="Explicit human operator approval for external tool execution")
    parser.add_argument("--correlate", action="store_true", help="Correlate external findings with native program findings")
    parser.add_argument("--budget", type=int, default=100, help="Agent request budget ceiling (default: 100)")
    parser.add_argument("--timeout", type=int, default=300, help="Process timeout budget in seconds (default: 300)")
    parser.add_argument("--json", action="store_true", help="Output results in JSON format")

    args = parser.parse_args()

    selector = ExternalEngineSelector()
    engines = {"xalgorix": XalgorixAdapter(), "strix": StrixAdapter()}

    if args.engine:
        engines = {args.engine: engines[args.engine]}

    # 1. JSON mode for simple detection/doctor
    if args.json and not (args.dry_run or args.run or args.correlate):
        if args.doctor:
            res = {k: v.health_check() for k, v in engines.items()}
        else:
            res = {k: v.detect() for k, v in engines.items()}
        print(json.dumps(res, indent=2))
        return

    # 2. Correlate mode
    if args.correlate:
        workspace = get_workspace_dir()
        prog_dir = os.path.join(workspace, "programs", args.program)
        state_mgr = WorkflowStateManager(prog_dir)
        workflows, hypotheses, findings = state_mgr.load()

        # Gather external findings from external/ directory
        ext_findings: List[ExternalFinding] = []
        ext_dir = os.path.join(prog_dir, "external")
        if os.path.isdir(ext_dir):
            for eng_name, adapter in engines.items():
                eng_path = os.path.join(ext_dir, eng_name)
                if os.path.isdir(eng_path):
                    for job_entry in os.listdir(eng_path):
                        job_entry_dir = os.path.join(eng_path, job_entry)
                        if os.path.isdir(job_entry_dir):
                            try:
                                parsed = adapter.parse_results(job_entry_dir)
                                ext_findings.extend(parsed)
                            except Exception:
                                pass

        unified = ExternalFindingCorrelator.correlate(findings, ext_findings)
        if args.json:
            print(json.dumps(unified, indent=2))
            return

        print("\n==============================================================================")
        print("               EXTERNAL FINDINGS CORRELATION REPORT                           ")
        print("==============================================================================")
        print(f"[*] Program:          {args.program}")
        print(f"[*] Native Findings:  {len(findings)}")
        print(f"[*] External Findings:{len(ext_findings)}")
        print(f"[*] Unified Findings: {len(unified)}")
        for u in unified:
            srcs = ", ".join(u.get("sources", []))
            print(f"\n[+] {u.get('title')} [{u.get('lifecycle')}]")
            print(f"    Category:     {u.get('category')} | Severity: {u.get('severity')}")
            print(f"    Endpoint:     {u.get('endpoint')}")
            print(f"    Sources:      {srcs}")
            print(f"    Attack Surface FP: {u.get('attack_surface_fingerprint')}")
            print(f"    Root Cause FP:     {u.get('root_cause_fingerprint')}")
            if u.get("external_confirmations"):
                for ec in u.get("external_confirmations"):
                    print(f"    -> Confirmed by {ec.get('engine')}: {ec.get('title')}")
        print("\n==============================================================================")
        return

    # 3. Dry-Run / Run Job Mode
    if args.dry_run or args.run:
        target_engine_name = args.engine or "xalgorix"
        adapter = engines[target_engine_name]
        workspace = get_workspace_dir()
        prog_dir = os.path.join(workspace, "programs", args.program)
        scope_eng = load_scope_engine(prog_dir, args.scope)

        targets = [t.strip() for t in args.targets.split(",")] if args.targets else ["http://127.0.0.1:8080/"]
        in_scope_targets = [t for t in targets if scope_eng.is_in_scope(t)]
        out_of_scope_targets = [t for t in targets if not scope_eng.is_in_scope(t)]

        det = adapter.detect()
        cli_path = det.get("executable_path") or target_engine_name

        dummy_job = ExternalJob(
            job_id="dryrun-job",
            program=args.program,
            engine=target_engine_name,
            engine_version=adapter.tested_release,
            tested_commit=adapter.tested_commit,
            target_set=in_scope_targets,
            scope_snapshot={"allowed": in_scope_targets},
            capabilities=[c.value for c in adapter.capabilities],
            approval_status="APPROVED" if args.approve else "PENDING_APPROVAL",
            agent_budget=args.budget,
            time_budget_seconds=args.timeout,
            artifact_directory=os.path.join(prog_dir, "external", target_engine_name, "dryrun-job"),
        )
        command_plan = adapter.build_argv(dummy_job, cli_path)

        if args.dry_run:
            print("\n==============================================================================")
            print("                 EXTERNAL ENGINE EXECUTION DRY-RUN                            ")
            print("==============================================================================")
            print(f"ENGINE:            {target_engine_name.upper()}")
            print(f"VERSION:           {adapter.tested_release} (Commit: {adapter.tested_commit})")
            print(f"STATUS:            {det['status']}")
            print(f"TARGETS:           {targets}")
            print(f"SCOPE RESULT:      {len(in_scope_targets)} in-scope, {len(out_of_scope_targets)} out-of-scope")
            if out_of_scope_targets:
                print(f"REJECTED TARGETS:  {out_of_scope_targets}")
            print(f"CAPABILITIES:      {[c.value for c in adapter.capabilities]}")
            print(f"BUDGET:            agent_budget={args.budget} requests, time_budget={args.timeout}s")
            print(f"TIMEOUT:           {args.timeout} seconds")
            print(f"COMMAND PLAN:      {' '.join(command_plan)}")
            print(f"OUTPUT PLAN:       {dummy_job.artifact_directory}")
            print(f"APPROVAL REQUIRED: {'YES (Supplied)' if args.approve else 'YES (Required — use --approve)'}")
            print("==============================================================================")
            print("[*] Dry-run completed safely. Engine was not executed.\n")
            return

        if args.run:
            if not args.approve:
                print("\n[-] EXECUTION BLOCKED: External engine execution requires explicit human approval.")
                print(f"    Please review the target plan and supply --approve to execute {target_engine_name.upper()}.\n")
                sys.exit(1)

            if not det["installed"]:
                print(f"\n[-] EXECUTION FAILED: {target_engine_name.upper()} is not installed on this system.")
                print(f"    Status: {det['status']}. Install {target_engine_name} manually or run in mock mode.\n")
                sys.exit(1)

            if not in_scope_targets:
                print("\n[-] EXECUTION BLOCKED: All requested targets are out-of-scope according to ScopeEngine.\n")
                sys.exit(1)

            job = adapter.prepare_job(
                program_dir=prog_dir,
                target_urls=in_scope_targets,
                scope_engine=scope_eng,
                budget_requests=args.budget,
                timeout_seconds=args.timeout,
                approval_granted=True,
            )
            print(f"\n[*] Launching {target_engine_name.upper()} for job {job.job_id}...")
            job = adapter.start(job)
            print(f"[+] Process started with PID {job.process_id}. Monitoring execution...")
            stat = adapter.status(job)
            print(f"[+] Status: {stat['status']} (running={stat['running']})")
            return

    # 4. Standard Registry / Detection / Doctor Display
    print("\n==============================================================================")
    print("                 EXTERNAL PENTESTING ENGINES REGISTRY                         ")
    print("==============================================================================")

    for name, adapter in engines.items():
        det = adapter.detect()
        installed_badge = f"[{det['status']}]" if det["installed"] else "[OPTIONAL / NOT INSTALLED]"
        print(f"\n[*] ENGINE: {name.upper()} {installed_badge}")
        print(f"    Repository:       {det['repo_url']}")
        print(f"    Tested Release:   {det['tested_release']} (Commit: {det['tested_commit']})")
        print(f"    Min Supported:    {det['min_supported_release']}")
        print(f"    Detected Version: {det.get('version') or 'None'}")
        print(f"    Executable Path:  {det.get('executable_path') or 'None'}")
        print(f"    Capabilities:     {[c.value for c in adapter.capabilities]}")

        if args.doctor:
            health = adapter.health_check()
            status_badge = "[HEALTHY / READY]" if health["healthy"] else f"[{health['status']}]"
            print(f"    Health Status:    {status_badge}")
            print(f"    Diagnostic Note:  {health['message']}")

    print("\n==============================================================================")


if __name__ == "__main__":
    main()
