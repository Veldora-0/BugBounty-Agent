#!/usr/bin/env python3
"""
bb-recon — Reconnaissance Intelligence CLI for BugBounty-Agent.

Executes capability-driven attack surface enrichment (DNS, TLS, HTTP, Ports,
Technologies, Endpoints) on in-scope assets. Maintains persistent, atomic,
and resumable reconnaissance state in ~/BugBounty-Workspace/programs/<name>/state/recon.json.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from typing import Any, Dict, List, Optional

if hasattr(sys.stdout, "reconfigure"):
    try:
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
        sys.stderr.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass

REPO_ROOT = os.environ.get(
    "BUGBOUNTY_AGENT_DIR",
    os.path.abspath(os.path.join(os.path.dirname(os.path.realpath(__file__)), "..")),
)
if REPO_ROOT not in sys.path:
    sys.path.insert(0, REPO_ROOT)

from framework.assets.graph import AssetGraph
from framework.assets.model import Asset, AssetType
from framework.common.config import get_program_dir
from framework.recon.engine import ReconnaissanceEngine
from framework.recon.state import ReconStateManager
from framework.scope.engine import ScopeEngine, ScopeStatus
from framework.state.manager import StateManager


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="BugBounty-Agent Reconnaissance Intelligence & Enrichment Engine",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  bb-recon --program acme-corp --tree
  bb-recon --domain example.com --scope scope.yaml --capabilities "http,dns,tls"
  bb-recon --program acme-corp --asset api.example.com --json
  bb-recon --program acme-corp --passive-only --dry-run
        """,
    )
    parser.add_argument(
        "-p", "--program",
        help="Program name in local workspace (resolves ~/BugBounty-Workspace/programs/<name>)",
    )
    parser.add_argument(
        "-s", "--scope",
        help="Path to scope.yaml definition (defaults to program's scope/scope.yaml)",
    )
    parser.add_argument(
        "-d", "--domain",
        help="Target apex root domain to evaluate",
    )
    parser.add_argument(
        "-a", "--asset",
        help="Specific asset hostname to enrich",
    )
    parser.add_argument(
        "-c", "--capabilities",
        help="Comma-separated reconnaissance capabilities: dns, tls, http, ports, tech, endpoints",
    )
    parser.add_argument(
        "--passive-only",
        action="store_true",
        help="Run passive analysis only (disables active network connections and probes)",
    )
    parser.add_argument(
        "--budget",
        type=int,
        default=500,
        help="Max asset hosts to enrich (default: 500)",
    )
    parser.add_argument(
        "--max-hosts",
        type=int,
        default=500,
        help="Ceiling on candidate hosts to process (alias for budget)",
    )
    parser.add_argument(
        "--max-requests",
        type=int,
        default=2000,
        help="Safety ceiling on active HTTP/TCP requests (default: 2000)",
    )
    parser.add_argument(
        "--tree",
        action="store_true",
        help="Render visual ASCII asset hierarchy tree including enriched services",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Output full reconnaissance state in JSON",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Perform evaluation without persisting results to program state",
    )
    parser.add_argument(
        "--resume",
        action="store_true",
        help="Skip assets that have already been probed in previous runs",
    )
    return parser.parse_args()


def render_recon_tree(graph: AssetGraph, recon_state: Optional[ReconStateManager]) -> None:
    """Renders visual ASCII tree of assets enriched with reconnaissance data."""
    print("Attack Surface Reconnaissance Hierarchy:")
    roots = graph.get_root_domains()
    if not roots:
        roots = [a for a in graph.get_all_assets() if not a.parent_id]

    for root in sorted(roots, key=lambda x: x.value):
        _print_node(graph, root, recon_state, prefix="", is_last=True)


def _print_node(graph: AssetGraph, asset: Asset, recon_state: Optional[ReconStateManager], prefix: str, is_last: bool) -> None:
    connector = "└── " if is_last else "├── "
    val = asset.value

    # Build annotations
    annotations = []
    if recon_state:
        https = recon_state.get_http_for_host(val)
        if https:
            statuses = ",".join(str(h.status_code) for h in https)
            annotations.append(f"HTTP:[{statuses}]")
            for h in https:
                if h.title:
                    clean_title = (h.title[:30] + "..") if len(h.title) > 30 else h.title
                    annotations.append(f'"{clean_title}"')
                    break
        techs = recon_state.get_technologies_for_host(val)
        if techs:
            t_names = ",".join(t.name for t in techs[:3])
            annotations.append(f"Tech:[{t_names}]")

    annot_str = f" ({' '.join(annotations)})" if annotations else ""
    print(f"{prefix}{connector}{val}{annot_str}")

    children = sorted(graph.get_children(asset.id), key=lambda x: x.value)
    new_prefix = prefix + ("    " if is_last else "│   ")
    for i, child in enumerate(children):
        _print_node(graph, child, recon_state, new_prefix, i == len(children) - 1)


def main() -> None:
    args = parse_args()

    prog_dir: Optional[str] = None
    state: Optional[StateManager] = None
    recon_state: Optional[ReconStateManager] = None
    scope_path: Optional[str] = args.scope

    if args.program:
        try:
            prog_dir = get_program_dir(args.program)
            state = StateManager(prog_dir)
            recon_state = state.get_recon_state()
            if not scope_path:
                candidate_scope = os.path.join(prog_dir, "scope", "scope.yaml")
                if os.path.isfile(candidate_scope):
                    scope_path = candidate_scope
        except Exception as e:
            print(f"[!] Error initializing program workspace: {e}", file=sys.stderr)
            sys.exit(1)

    # Initialize Scope Engine if available
    scope_engine: Optional[ScopeEngine] = None
    if scope_path and os.path.isfile(scope_path):
        try:
            scope_engine = ScopeEngine.from_file(scope_path)
        except Exception as e:
            print(f"[!] Error loading scope configuration from '{scope_path}': {e}", file=sys.stderr)
            sys.exit(1)
    elif scope_path and not os.path.isfile(scope_path):
        print(f"[!] Scope file not found: {scope_path}", file=sys.stderr)
        sys.exit(1)

    # Load existing AssetGraph
    graph = AssetGraph()
    if state:
        try:
            graph = state.get_asset_graph()
        except Exception:
            pass

    # If domain explicitly supplied and not in graph, insert it
    if args.domain:
        d_clean = args.domain.strip().lower()
        if not graph.has_asset(d_clean):
            graph.add_asset(Asset.create(AssetType.ROOT_DOMAIN, d_clean))

    if args.asset:
        a_clean = args.asset.strip().lower()
        if not graph.has_asset(a_clean):
            graph.add_asset(Asset.create(AssetType.SUBDOMAIN, a_clean))

    # Parse capabilities
    caps = None
    if args.capabilities:
        caps = [c.strip() for c in args.capabilities.replace(" ", ",").split(",") if c.strip()]

    max_hosts = min(args.budget, args.max_hosts)

    # Filter candidate assets if --asset or --resume
    candidates = graph.get_all_assets()
    if args.asset:
        candidates = [a for a in candidates if a.value.lower() == args.asset.strip().lower()]
    elif args.resume and recon_state:
        candidates = [a for a in candidates if not recon_state.is_probed(a.value)]

    print(f"[*] Starting Reconnaissance Intelligence Engine...")
    print(f"[*] Total target assets eligible: {len(candidates)}")
    print(f"[*] Capabilities enabled: {', '.join(caps) if caps else 'all default (dns, tls, http, ports, tech)'}")
    print(f"[*] Mode: {'Passive Only' if args.passive_only else 'Full Active/Passive'}")
    print(f"[*] Host budget ceiling: {max_hosts} | Request ceiling: {args.max_requests}")

    engine = ReconnaissanceEngine(
        scope_engine=scope_engine,
        graph=graph,
        recon_state=recon_state,
        passive_only=args.passive_only,
        max_hosts=max_hosts,
        max_requests=args.max_requests,
        dry_run=args.dry_run,
    )

    stats = engine.run_reconnaissance(assets=candidates, capabilities=caps)

    # If new assets were discovered from TLS SANs and not dry-run, save graph
    if state and not args.dry_run and stats.get("new_assets_discovered", 0) > 0:
        state.save_asset_graph(graph)

    print(f"[+] Reconnaissance pass complete:")
    print(f"    - Hosts processed: {stats['hosts_processed']}")
    print(f"    - HTTP services identified: {stats['http_services_found']}")
    print(f"    - Open ports detected: {stats['ports_found']}")
    print(f"    - DNS records documented: {stats['dns_records_found']}")
    print(f"    - TLS certificates examined: {stats['tls_certificates_found']}")
    print(f"    - Technologies fingerprinted: {stats['technologies_found']}")
    print(f"    - Endpoints mapped: {stats['endpoints_found']}")
    print(f"    - New assets from TLS SANs: {stats['new_assets_discovered']}")

    if args.tree:
        print()
        render_recon_tree(graph, recon_state)

    if args.json:
        if recon_state:
            with open(recon_state.recon_file, "r", encoding="utf-8") as f:
                print(f.read())
        else:
            print(json.dumps(stats, indent=2))


if __name__ == "__main__":
    main()
