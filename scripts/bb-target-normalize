#!/usr/bin/env python3
"""
bb-target-normalize — Hostname, URL, and Target Normalization utility.

Normalizes inputs and tests DNS-label boundaries.
"""

import argparse
import json
import os
import sys

# Ensure repository root is on sys.path
REPO_ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
if REPO_ROOT not in sys.path:
    sys.path.insert(0, REPO_ROOT)

from framework.scope.normalizer import (
    NormalizationError,
    parse_and_normalize_target,
)


def main():
    parser = argparse.ArgumentParser(
        description="Canonicalize target inputs (domains, URLs, IPs, CIDRs) and detect formatting defects."
    )
    parser.add_argument("target", nargs="?", help="Target string to normalize")
    parser.add_argument("--json", action="store_true", help="Output result as JSON")
    args = parser.parse_args()

    target_str = args.target
    if not target_str and not sys.stdin.isatty():
        target_str = sys.stdin.read().strip()

    if not target_str:
        parser.print_help()
        sys.exit(1)

    try:
        parsed = parse_and_normalize_target(target_str)
        # Convert non-serializable objects (IPv4Network / IPv4Address)
        cleaned = {}
        for k, v in parsed.items():
            cleaned[k] = str(v)

        if args.json:
            print(json.dumps(cleaned, indent=2))
        else:
            print(f"Type:       {cleaned.get('type')}")
            print(f"Raw:        {cleaned.get('raw')}")
            print(f"Normalized: {cleaned.get('normalized')}")
            if "clean_host" in cleaned:
                print(f"Clean Host: {cleaned.get('clean_host')}")
            if "port" in cleaned:
                print(f"Port:       {cleaned.get('port')}")
    except NormalizationError as e:
        print(f"[!] Normalization Error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
