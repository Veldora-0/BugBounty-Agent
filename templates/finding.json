{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Finding",
  "type": "object",
  "required": [
    "title",
    "summary",
    "affected_asset",
    "affected_endpoint",
    "vulnerability_type",
    "severity",
    "description",
    "root_cause",
    "prerequisites",
    "reproduction_steps",
    "expected_result",
    "observed_result",
    "security_impact",
    "remediation",
    "scope_reference",
    "confidence"
  ],
  "properties": {
    "finding_id": { "type": "string" },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "affected_asset": { "type": "string" },
    "affected_endpoint": { "type": "string" },
    "vulnerability_type": { "type": "string" },
    "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFORMATIONAL"] },
    "confidence": { "type": "string", "enum": ["CONFIRMED", "HIGH", "MEDIUM", "LOW"] },
    "lifecycle_state": { "type": "string", "enum": ["OBSERVATION", "HYPOTHESIS", "CANDIDATE", "VALIDATED", "REJECTED", "DUPLICATE", "INFORMATIONAL"] },
    "description": { "type": "string" },
    "root_cause": { "type": "string" },
    "prerequisites": { "type": "string" },
    "reproduction_steps": { "type": "array", "items": { "type": "string" } },
    "expected_result": { "type": "string" },
    "observed_result": { "type": "string" },
    "security_impact": { "type": "string" },
    "remediation": { "type": "string" },
    "scope_reference": { "type": "string" },
    "evidence": { "type": "array", "items": { "type": "object" } },
    "provenance": { "type": "object" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "validation_notes": { "type": ["string", "null"] },
    "duplicate_of": { "type": ["string", "null"] }
  }
}
